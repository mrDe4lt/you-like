# Backend Environment Variables
# ==============================

# Server Configuration
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000

# Database
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/edulearn?retryWrites=true&w=majority
DB_NAME=edulearn

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_change_this
JWT_REFRESH_EXPIRE=30d

# Cloudinary Configuration
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Flutterwave Configuration
FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key

# Email Configuration (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDER_EMAIL=noreply@edulearn.com

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Admin Email
ADMIN_EMAIL=admin@edulearn.com
ADMIN_PASSWORD=change_this_password

# Stripe (Optional Payment Alternative)
STRIPE_PUBLIC_KEY=your_stripe_public_key
STRIPE_SECRET_KEY=your_stripe_secret_key

# Session Secret
SESSION_SECRET=your_session_secret_change_this

# Enable Features
ENABLE_EMAIL_VERIFICATION=true
ENABLE_TWO_FACTOR_AUTH=false
ENABLE_LIVE_CLASSES=false
